---
// src/pages/blog/index.astro
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog | Compass Rose & Digital Spirit Level</title>
  <meta name="description" content="Explore articles about navigation, compass history, magnetic declination, and modern digital alignment tools." />
  <link rel="canonical" href="https://compassrosetool.com/blog/" />
  <script is:inline>
    // Inherit dark mode preference
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark');
      }
    } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="bg-zinc-50 dark:bg-[#09090b] text-zinc-900 dark:text-zinc-300 font-sans antialiased transition-colors duration-200">
  
  <!-- Simple Header -->
  <header class="w-full border-b border-zinc-200 dark:border-zinc-800 p-4">
    <div class="max-w-4xl mx-auto flex items-center justify-between">
      <a href="/" class="text-xl font-bold tracking-tight hover:opacity-80 transition-opacity">
        <span class="text-rose-500">✛</span> Compass Rose
      </a>
      <a href="/" class="text-sm font-medium hover:text-rose-500 transition-colors">Back to Tool</a>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-12 sm:py-20">
    <div class="mb-12">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-zinc-900 dark:text-white mb-4">Navigation Hub</h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400">Master the art of finding your way with our guides on history, design, and modern digital navigation.</p>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Article Card -->
      <a href="/blog/decoding-the-compass-rose" class="group flex flex-col bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 overflow-hidden hover:border-rose-500/50 dark:hover:border-rose-500/50 hover:shadow-lg transition-all duration-300">
        <!-- Placeholder for future image (aspect video) -->
        <div class="w-full aspect-video bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center overflow-hidden">
          <div class="text-5xl group-hover:scale-110 transition-transform duration-500">🧭</div>
        </div>
        <div class="p-6 flex flex-col flex-grow">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2.5 py-0.5 rounded-full bg-rose-100 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs font-bold uppercase tracking-wider">Guide</span>
            <span class="text-xs text-zinc-500">10 Min Read</span>
          </div>
          <h2 class="text-xl font-bold text-zinc-900 dark:text-white mb-2 group-hover:text-rose-500 transition-colors">Decoding the Compass Rose: From Ancient Mariners to Digital Navigation</h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4 line-clamp-3">Discover the fascinating evolution of the compass rose—from early Mediterranean wind charts to the cutting-edge digital sensors in your smartphone.</p>
          <div class="mt-auto pt-4 border-t border-zinc-100 dark:border-zinc-800 text-sm font-bold text-rose-500 group-hover:translate-x-1 transition-transform">
            Read Article →
          </div>
        </div>
      </a>

    </div>
  </main>
</body>
</html>