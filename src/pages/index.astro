  <meta property="og:description" content="Use our free online compass tool and digital spirit level. Get accurate live compass direction, degrees, and a precision bull's eye spirit level for mobile.">
  <meta property="og:image" content="https://compassrosetool.com/og-image.jpg">

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Compass Rose Tool" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- AI & Search Engine Optimization: Web App Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Compass Rose & Digital Spirit Level",
      "url": "https://compassrosetool.com",
      "description": "High-speed, precision alignment tool. Find True North and measure surface tilt instantly directly in your browser.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      }
    }
  </script>

  <!-- AI & Search Engine Optimization: FAQ Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a compass rose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A compass rose is a figure displayed on a compass, map, nautical chart, or monument used to display the orientation of the cardinal directions (North, East, South, and West) and their intermediate points."
          }
        },
        {
          "@type": "Question",
          "name": "What does a compass rose look like?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It typically looks like a multi-pointed star. A standard compass rose features 16 points (or 32 for maritime navigation), with the four primary cardinal directions (N, E, S, W) being the longest and most prominent."
          }
        },
        {
          "@type": "Question",
          "name": "How does an online compass work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An online compass works by accessing the magnetometer and accelerometer sensors built into your mobile device. It reads the Earth's magnetic field and translates that data into a visual orientation on your web browser."
          }
        },
        {
          "@type": "Question",
          "name": "How does a magnetic compass work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A traditional magnetic compass contains a lightweight magnetic needle that freely rotates on a pivot. The magnetized needle aligns itself with the Earth's magnetic field, naturally pointing towards magnetic North."
          }
        },
        {
          "@type": "Question",
          "name": "What are some tips for the accuracy of an online compass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To ensure accuracy, keep your device away from metallic phone cases, magnets, and heavy electrical equipment. If the compass seems stuck, calibrate your device by moving it in a 'Figure 8' motion in the air to reset the magnetometer."
          }
        },
        {
          "@type": "Question",
          "name": "How do I find direction using a mobile compass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Open the online compass tool, hold your phone flat (parallel to the ground), and point the top of your phone in the direction you want to measure. The screen will display your exact degree bearing and cardinal direction."
          }
        },
        {
          "@type": "Question",
          "name": "How do I find which direction I'm facing? / How can I see my current direction?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simply hold your smartphone flat in front of you while using our tool. The top edge of your phone represents your line of sight. The large degree number and cardinal letter on the screen indicate the exact direction you are facing."
          }
        },
        {
          "@type": "Question",
          "name": "Can a phone be used as a compass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, almost all modern smartphones have a built-in magnetometer, allowing them to function as a highly accurate digital compass when paired with a web or native compass application."
          }
        },
        {
          "@type": "Question",
          "name": "How do I activate a compass?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On Android, the browser usually accesses the sensor automatically upon loading the page. On iOS devices, you must click the 'Start Compass' button on the screen to manually grant the browser permission to read your motion and orientation sensors."
          }
        },
        {
          "@type": "Question",
          "name": "Which mobile phones have a compass sensor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The vast majority of modern smartphones, including all Apple iPhones, Samsung Galaxy devices, Google Pixels, and most mid-to-high-tier Android phones, feature built-in compass sensors (magnetometers)."
          }
        },
        {
          "@type": "Question",
          "name": "What is a spirit level?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A spirit level, also known as a bubble level, is an instrument designed to indicate whether a surface is perfectly horizontal (level) or vertical (plumb)."
          }
        },
        {
          "@type": "Question",
          "name": "How do you use a spirit level?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Place the spirit level flat against the surface you want to measure. For our digital bull's eye level, lay your phone flat on the table or surface and observe the bubble's position relative to the center ring."
          }
        },
        {
          "@type": "Question",
          "name": "How do you read a spirit level?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Read the level by looking at the bubble. If the bubble is perfectly centered within the target rings, the surface is flat (0° tilt). If the bubble drifts to one side, that specific side of the surface is elevated."
          }
        },
        {
          "@type": "Question",
          "name": "What is a spirit level used for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is used in construction, carpentry, photography, and DIY home projects to ensure objects like picture frames, shelves, tables, and camera tripods are perfectly aligned, straight, and balanced."
          }
        },
        {
          "@type": "Question",
          "name": "How does a spirit level work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A physical spirit level uses a liquid-filled vial containing a small air bubble that naturally seeks the highest point. A digital spirit level uses your phone's built-in accelerometer to measure gravitational pull along the X and Y axes."
          }
        },
        {
          "@type": "Question",
          "name": "How does an online spirit level work on mobile?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The online spirit level reads data from your smartphone's internal accelerometer via the web browser, translating the device's physical pitch and roll into a visual digital bubble display on your screen."
          }
        },
        {
          "@type": "Question",
          "name": "How to calibrate a spirit level?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To ensure your digital spirit level is accurate, you can calibrate your phone's motion sensors via your device's system settings. Additionally, always make sure your phone does not have a thick, uneven case that might cause it to lay at an angle."
          }
        },
        {
          "@type": "Question",
          "name": "What is a bull's eye spirit level?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A bull's eye spirit level is a circular, two-dimensional level that measures surface tilt in all directions simultaneously (both pitch and roll), unlike a traditional tubular level that only measures one axis at a time."
          }
        },
        {
          "@type": "Question",
          "name": "Are digital spirit levels accurate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, digital spirit levels use your mobile device's highly sensitive internal accelerometers and gyroscopes. When properly calibrated and used without a thick phone case, they can measure surface tilt accurately down to fractions of a degree."
          }
        },
        {
          "@type": "Question",
          "name": "How do I know if my spirit level is working correctly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can test any spirit level by placing it on a flat surface and noting the bubble's position. Then, rotate the level 180 degrees exactly in the same spot. If the bubble rests in the exact same position both times, the tool is accurate."
          }
        }
      ]
    }
  </script>

  <!-- Prevent theme flash on load -->
  <script is:inline>
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return 'dark';
      }
      return 'light';
    })();
    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>

