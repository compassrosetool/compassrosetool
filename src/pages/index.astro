  <script>
    // Theme Toggle Logic
    const themeToggleBtn = document.getElementById('theme-toggle');
    const darkIcon = document.getElementById('theme-toggle-dark-icon');
    const lightIcon = document.getElementById('theme-toggle-light-icon');

    if (document.documentElement.classList.contains('dark')) {
      lightIcon?.classList.remove('hidden');
    } else {
      darkIcon?.classList.remove('hidden');
    }

    themeToggleBtn?.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      if (document.documentElement.classList.contains('dark')) {
        localStorage.setItem('theme', 'dark');
        lightIcon?.classList.remove('hidden');
        darkIcon?.classList.add('hidden');
      } else {
        localStorage.setItem('theme', 'light');
        darkIcon?.classList.remove('hidden');
        lightIcon?.classList.add('hidden');
      }
    });

    // Compass Tools Logic
    const points = ["NORTH", "NNE", "NE", "ENE", "EAST", "ESE", "SE", "SSE", "SOUTH", "SSW", "SW", "WSW", "WEST", "WNW", "NW", "NNW"];
    
    function getCardinal(deg) {
      const normalized = (deg % 360 + 360) % 360;
      const index = Math.round(normalized / 22.5) % 16;
      return points[index];
    }

    const dial = document.getElementById('compass-dial');
    const headingDeg = document.getElementById('heading-degrees');
    const headingCard = document.getElementById('heading-cardinal');
    const alignmentLine = document.getElementById('alignment-line');
    const permtn = document.getElementById('btn-start');
    const levelBubble = document.getElementById('level-bubble');
    const levelDeg = document.getElementById('level-deg');

    // Generate responsive ticks locked to dark hex colors
    const dialTicks = document.getElementById('dial-ticks');
    if (dialTicks) {
      let ticksHTML = '';
      for (let i = 0; i < 360; i += 5) {
        let isPrimary = i % 30 === 0;
        let isCardinal = i % 90 === 0;
        
        let length = isPrimary ? (isCardinal ? 16 : 12) : 6;
        let width = isPrimary ? 2.5 : 1.5;
        let yPos = isPrimary ? 18 : 22;
        let color = isCardinal && i === 0 ? '#f43f5e' : (isPrimary ? '#d4d4d8' : '#52525b');
        
        ticksHTML += `<rect x="198.75" y="${yPos}" width="${width}" height="${length}" fill="${color}" transform="rotate(${i} 200 200)" />`;
      }
      dialTicks.innerHTML = ticksHTML;
    }

    // Add a tracker for continuous rotation to fix the 360-to-0 snap glitch
    // Target rotation from sensor, and actual smoothed rotation for the UI
    let targetRotation = 0;
    let smoothedRotation = 0;

    function updateCompassUI(deg) {
      let normalizedDeg = (deg % 360 + 360) % 360;
      let rounded = Math.round(normalizedDeg);
      if (rounded === 360) rounded = 0; 
      
      let delta = deg - ((-targetRotation) % 360);
      if (delta > 180) delta -= 360;
      else if (delta < -180) delta += 360;
      
      targetRotation -= delta;

      if (headingDeg && headingCard) {
        headingDeg.textContent = `${rounded}`; 
        headingCard.textContent = getCardinal(rounded);
        
        if (rounded === 0 || rounded === 90 || rounded === 180 || rounded === 270) {
          headingDeg.classList.add('text-green-500');
          headingDeg.classList.remove('text-zinc-900', 'dark:text-white');
          headingCard.classList.add('text-green-500');
          headingCard.classList.remove('text-rose-500', 'text-zinc-500', 'dark:text-zinc-400');
          
          if (alignmentLine) {
            alignmentLine.classList.replace('bg-rose-500', 'bg-green-500');
            alignmentLine.classList.replace('shadow-[0_0_10px_rgba(244,63,94,0.5)]', 'shadow-[0_0_10px_rgba(34,197,94,0.5)]');
          }
        } else {
          headingDeg.classList.remove('text-green-500');
          headingDeg.classList.add('text-zinc-900', 'dark:text-white');
          headingCard.classList.remove('text-green-500');
          headingCard.classList.add('text-rose-500'); 
          
          if (alignmentLine) {
            alignmentLine.classList.replace('bg-green-500', 'bg-rose-500');
            alignmentLine.classList.replace('shadow-[0_0_10px_rgba(34,197,94,0.5)]', 'shadow-[0_0_10px_rgba(244,63,94,0.5)]');
          }
        }
      }
    }

    function animateCompass() {
      smoothedRotation += (targetRotation - smoothedRotation) * 0.05;
      if (dial) {
        dial.style.transition = "none"; 
        dial.style.transform = `rotate(${smoothedRotation}deg)`;
      }
      requestAnimationFrame(animateCompass);
    }
    
    animateCompass();

    function updateLevelUI(beta, gamma) {
      if (!levelBubble || !levelDeg) return;
      const maxDist = 90; 
      let x = (gamma / 45) * maxDist; 
      let y = (beta / 45) * maxDist;
      
      const currentRadius = Math.sqrt(x*x + y*y);
      if (currentRadius > maxDist) {
        x = (x / currentRadius) * maxDist;
        y = (y / currentRadius) * maxDist;
      }
      
      levelBubble.style.transition = "transform 0.1s ease-out";
      levelBubble.style.transform = `translate(${x}px, ${y}px)`;
      
      const totalTilt = Math.sqrt(beta*beta + gamma*gamma);
      levelDeg.textContent = Math.min(totalTilt, 90).toFixed(1) + '°';

      if (totalTilt < 0.5) {
        levelDeg.classList.add('text-green-500');
        levelDeg.classList.remove('text-zinc-900', 'dark:text-white');
        levelBubble.classList.add('bg-green-500');
        levelBubble.classList.remove('bg-blue-500');
      } else {
        levelDeg.classList.remove('text-green-500');
        levelDeg.classList.add('text-zinc-900', 'dark:text-white');
        levelBubble.classList.remove('bg-green-500');
        levelBubble.classList.add('bg-blue-500');
      }
    }

    function handleOrientation(event) {
      let heading = 0;
      
      // Strict number check prevents 'undefined' from freezing the dial
      if (typeof event.webkitCompassHeading === 'number') {
        heading = event.webkitCompassHeading;
      } else if (typeof event.alpha === 'number') {
        heading = (360 - event.alpha) % 360;
      }
      
      updateCompassUI(heading);
      updateLevelUI(event.beta || 0, event.gamma || 0);
    }

    if (permtn) {
      permtn.classList.remove('hidden');
      permtn.addEventListener('click', async () => {
        if (typeof DeviceOrientationEvent !== 'undefined' && typeof (DeviceOrientationEvent).requestPermission === 'function') {
          try {
            const res = await (DeviceOrientationEvent).requestPermission();
            if (res === "granted") {
              window.addEventListener("deviceorientation", handleOrientation, true);
              permtn.classList.add('hidden');
            }
          } catch (err) {
            console.error(err);
          }
        } else {
          window.addEventListener("deviceorientationabsolute", handleOrientation, true);
          permtn.classList.add('hidden');
        }
      });
    } else {
      window.addEventListener("deviceorientationabsolute", handleOrientation, true);
    }

    // Tabs
    const tabCompass = document.getElementById('tab-compass');
    const tabLevel = document.getElementById('tab-level');
    const viewCompass = document.getElementById('view-compass');
    const viewLevel = document.getElementById('view-level');

    tabCompass?.addEventListener('click', () => {
      tabCompass.className = "px-6 py-2 rounded-full bg-zinc-800 text-white shadow-md transition-colors";
      tabCompass.setAttribute('aria-selected', 'true');
      tabLevel.className = "px-6 py-2 rounded-full text-zinc-400 hover:text-white transition-colors";
      tabLevel.setAttribute('aria-selected', 'false');
      
      viewCompass.classList.remove('hidden');
      viewCompass.classList.add('flex');
      viewLevel.classList.add('hidden');
      viewLevel.classList.remove('flex');
    });

    tabLevel?.addEventListener('click', () => {
      tabLevel.className = "px-6 py-2 rounded-full bg-zinc-800 text-white shadow-md transition-colors";
      tabLevel.setAttribute('aria-selected', 'true');
      tabCompass.className = "px-6 py-2 rounded-full text-zinc-400 hover:text-white transition-colors";
      tabCompass.setAttribute('aria-selected', 'false');
      
      viewLevel.classList.remove('hidden');
      viewLevel.classList.add('flex');
      viewCompass.classList.add('hidden');
      viewCompass.classList.remove('flex');
    });

    // Copy flag URL helper
    const copyBtn = document.getElementById("btn-copy-flag");
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("chrome://flags/#enable-generic-sensor-extra-classes");
        copyBtn.textContent = "Copied!";
        setTimeout(() => { copyBtn.textContent = "Copy Link"; }, 2000);
      } catch (err) {
        console.error(err);
      }
    });

    // Sensor availability fallback check
    let sensorReceived = false;
    const sensorWarning = document.getElementById("sensor-warning");

    function checkOrientationWorking(e) {
      if (e.alpha !== null || e.webkitCompassHeading !== undefined) {
        sensorReceived = true;
        sensorWarning?.classList.add("hidden");
      }
    }

    window.addEventListener("deviceorientation", checkOrientationWorking, { once: true });
    window.addEventListener("deviceorientationabsolute", checkOrientationWorking, { once: true });

    // If after 2.5 seconds no orientation data arrived, reveal the warning banner
    setTimeout(() => {
      if (!sensorReceived) {
        sensorWarning?.classList.remove("hidden");
      }
    }, 2500);

    // Initialize with 0
    updateCompassUI(0);
  </script>
